{
  "manifest_version": 3,
  "name": "EVA Media Detector",
  "version": "1.0.0",
  "description": "Meldet EVA ausschließlich, ob in einem Browser-Tab ein Video läuft.",
  "permissions": [],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
